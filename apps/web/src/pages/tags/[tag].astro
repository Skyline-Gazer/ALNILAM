---
import { getCollection, type CollectionEntry } from "astro:content";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import PostPage from "@alnilam/theme-shirone/PostPage.astro";
import { withBase } from "../../lib/i18n.mjs";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const byTag = new Map<string, CollectionEntry<"posts">[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }
  return [...byTag.entries()].map(([tag, list]) => ({
    params: { tag },
    props: { list: list.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) },
  }));
}
const { tag } = Astro.params;
const { list } = Astro.props as { list: CollectionEntry<"posts">[] };
---
<MainGridLayout title={`#${tag}`} description={`标签 ${tag} 下的全部文章`} page="tags">
  <a href={withBase("/tags/")} class="text-[var(--primary)]">← 全部标签</a>
  <PageHeader title={`#${tag}`} subtitle={`${list.length} 篇文章`} />
  <PostPage page={{data: list}} />
</MainGridLayout>
