---
import { getCollection, type CollectionEntry } from "astro:content";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import ArchivePanel from "@alnilam/theme-shirone/ArchivePanel.svelte";
import { canonicalUrl, postPath, withBase } from "../../lib/i18n.mjs";
import { loadSite } from "../../lib/site-source.mjs";
import { breadcrumbListJsonLd, collectionPageJsonLd } from "../../lib/seo.mjs";
import { canonicalTagSlug, comparePosts, loadSiteTaxonomy, tagDisplayLabel } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const { root, config } = loadSite();
  const taxonomy = loadSiteTaxonomy(root, config);
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const byTag = new Map<string, CollectionEntry<"posts">[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }
  for (const entry of taxonomy.tags) {
    const matchesEntry = (tag: string) =>
      tag === entry.slug || tag === entry.id ||
      tag.toLowerCase() === entry.slug || tag.toLowerCase() === entry.id ||
      Object.values(entry.label).includes(tag);
    const matching = posts.filter((post) => post.data.tags.some(matchesEntry));
    if (matching.length > 0) {
      for (const tag of byTag.keys()) {
        if (matchesEntry(tag)) byTag.set(tag, matching);
      }
      byTag.set(entry.slug, matching);
    }
  }
  return [...byTag.entries()].map(([tag, list]) => ({
    params: { tag },
    props: {
      list: [...list].sort(comparePosts),
      label: tagDisplayLabel(tag, taxonomy.tags, config.site.locale),
      tagLabels: Object.fromEntries(
        taxonomy.tags.map((entry) => [entry.slug, tagDisplayLabel(entry.slug, taxonomy.tags, config.site.locale)]),
      ),
    },
  }));
}
const { list, label, tagLabels } = Astro.props as {
  list: CollectionEntry<"posts">[];
  label: string;
  tagLabels: Record<string, string>;
};
const { root, config } = loadSite();
const taxonomy = loadSiteTaxonomy(root, config);
// Case- and label-variant routes stay reachable for existing links, but they
// duplicate the catalog-slug page: mark them noindex and keep them out of the
// sitemap. Static output cannot issue a 301, so this is a compatibility page,
// never a claimed redirect or an indexed canonical.
const canonicalSlug = canonicalTagSlug(Astro.params.tag, taxonomy.tags);
const isAlias = Astro.params.tag !== canonicalSlug;
const canonical = canonicalUrl(
  `/tags/${encodeURIComponent(Astro.params.tag)}/`,
  config.site.url,
);
const mappedPosts = list.map((post) => ({
  slug: post.id,
  url: withBase(postPath(post, config.site.locale) + "/"),
  data: {
    title: post.data.title,
    tags: post.data.tags,
    category: post.data.category || null,
    published: post.data.pubDate,
  },
}));
const collectionJsonLd = collectionPageJsonLd({
  name: `#${label}`,
  description: `标签 ${label} 下的全部文章`,
  url: canonical,
  inLanguage: config.site.locale,
  items: list.map((post) => canonicalUrl(postPath(post, config.site.locale) + "/", config.site.url)),
});
const breadcrumbJsonLd = breadcrumbListJsonLd([
  { name: "首页", url: canonicalUrl("/", config.site.url) },
  { name: "标签", url: canonicalUrl("/tags/", config.site.url) },
  { name: `#${label}`, url: canonical },
]);
---
<MainGridLayout title={`#${label}`} description={`标签 ${label} 下的全部文章`} page="tags" noindex={isAlias}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <a href={withBase("/tags/")} class="text-[var(--primary)]">← 全部标签</a>
  <PageHeader title={`#${label}`} subtitle={`${list.length} 篇文章`} />
  <ArchivePanel
    client:visible
    sortedPosts={mappedPosts}
    initialTag={Astro.params.tag}
    preScoped
    breadcrumb={{ href: withBase("/tags/"), label: "标签", value: `#${label}` }}
    tagLabels={tagLabels}
  />
</MainGridLayout>
