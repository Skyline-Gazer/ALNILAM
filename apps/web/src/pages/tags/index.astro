---
import { getCollection } from "astro:content";
import BaseLayout from "@alnilam/theme-shirone/BaseLayout.astro";
import { loadSite } from "../../lib/site-source.mjs";
import { canonicalUrl, withBase } from "../../lib/i18n.mjs";
const { config } = loadSite();
const layout = { siteTitle: config.site.title, appearance: config.theme.appearance, locale: config.site.locale, showBangumi: config.bangumi?.enabled ?? false };
const posts = await getCollection("posts", ({ data }) => !data.draft);
const byTag = new Map();
for (const post of posts) {
  for (const tag of post.data.tags) {
    if (!byTag.has(tag)) byTag.set(tag, []);
    byTag.get(tag).push(post);
  }
}
const tags = [...byTag.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
---
<BaseLayout title="标签" {...layout} description="按标签浏览文章" canonical={canonicalUrl("/tags/", config.site.url)}>
  <header class="page-heading">
    <p class="page-heading__eyebrow">Index</p>
    <h1>标签</h1>
    <p>{tags.length} 个标签</p>
  </header>
  {tags.length ? (
    <div class="tag-cloud">
      {tags.map(([tag, list]) => (
        <a href={withBase(`/tags/${tag}/`)}>
          #{tag} <span>{list.length}</span>
        </a>
      ))}
    </div>
  ) : <p>暂无标签。</p>}
</BaseLayout>
