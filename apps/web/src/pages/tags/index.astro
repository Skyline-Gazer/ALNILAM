---
import { getCollection } from "astro:content";
import BaseLayout from "@alnilam/theme-editorial/BaseLayout.astro";
import { loadSite } from "../../lib/site-source.mjs";
const { config } = loadSite();
const layout = { siteTitle: config.site.title, appearance: config.theme.appearance, locale: config.site.locale, showBangumi: config.bangumi?.enabled ?? false };
const posts = await getCollection("posts", ({ data }) => !data.draft);
const byTag = new Map();
for (const post of posts) {
  for (const tag of post.data.tags) {
    if (!byTag.has(tag)) byTag.set(tag, []);
    byTag.get(tag).push(post);
  }
}
const tags = [...byTag.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
---
<BaseLayout title="标签" {...layout} description="按标签浏览文章" canonical={new URL("/tags/", config.site.url).toString()}>
  <header class="mb-10">
    <h1 class="text-4xl font-bold tracking-tight" style="color: var(--fg)">标签</h1>
    <p class="mt-2 text-sm" style="color: var(--fg-muted)">{tags.length} 个标签</p>
  </header>
  {tags.length ? (
    <div class="flex flex-wrap gap-3">
      {tags.map(([tag, list]) => (
        <a
          href={`/tags/${tag}/`}
          class="rounded-full px-4 py-2 text-sm font-medium transition-colors hover:[color:var(--accent)]"
          style="background: var(--accent-soft); color: var(--accent)"
        >
          #{tag} <span style="color: var(--fg-muted)">{list.length}</span>
        </a>
      ))}
    </div>
  ) : <p style="color: var(--fg-muted)">暂无标签。</p>}
</BaseLayout>
