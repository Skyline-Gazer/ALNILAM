---
import { getCollection, type CollectionEntry } from "astro:content";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import ArchivePanel from "@alnilam/theme-shirone/ArchivePanel.svelte";
import { canonicalUrl, postLang, postPath, routeAlternates, withBase } from "../../lib/i18n.mjs";
import { loadSite } from "../../lib/site-source.mjs";
import { breadcrumbListJsonLd, collectionPageJsonLd } from "../../lib/seo.mjs";
import { categoryDisplayLabel, comparePosts, loadSiteTaxonomy } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const { root, config } = loadSite();
  const taxonomy = loadSiteTaxonomy(root, config);
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const series = await getCollection("series");
  const seriesCategories = new Map(series.map((entry) => [entry.id, entry.data.defaultCategory]));
  const postCategory = (post: CollectionEntry<"posts">) =>
    post.data.category?.trim() || seriesCategories.get(post.data.series?.trim())?.trim() || "";
  const matchesCategory = (cat: string, target: string) => {
    if (cat === target) return true;
    const entry = taxonomy.categories.find((item) => item.slug === target || item.id === target);
    return !!entry && (cat === entry.slug || cat === entry.id || Object.values(entry.label).includes(cat));
  };
  const byCategory = new Map<string, CollectionEntry<"posts">[]>();
  for (const post of posts) {
    const category = post.data.category?.trim() || seriesCategories.get(post.data.series?.trim())?.trim();
    if (!category || category.includes("/")) continue;
    if (!byCategory.has(category)) byCategory.set(category, []);
    byCategory.get(category)!.push(post);
  }
  for (const entry of taxonomy.categories) {
    const matching = posts.filter(
      (post) =>
        post.data.category === entry.slug ||
        post.data.category === entry.id ||
        Object.values(entry.label).includes(post.data.category),
    );
    if (matching.length > 0 && !byCategory.has(entry.slug)) {
      byCategory.set(entry.slug, matching);
    }
  }
  return [...byCategory.entries()].map(([category, list]) => ({
    params: { category },
    props: {
      list: [...list].sort(comparePosts),
      label: categoryDisplayLabel(category, taxonomy.categories, config.site.locale),
      categoryLabels: Object.fromEntries(
        taxonomy.categories.map((entry) => [
          entry.slug,
          categoryDisplayLabel(entry.slug, taxonomy.categories, config.site.locale),
        ]),
      ),
      activeLocales: [
        config.site.locale,
        ...config.locales.filter(
          (loc) =>
            loc !== config.site.locale &&
            posts.some((post) => postLang(post, config.site.locale) === loc && matchesCategory(postCategory(post), category)),
        ),
      ],
    },
  }));
}

const { list, label, categoryLabels, activeLocales } = Astro.props as {
  list: CollectionEntry<"posts">[];
  label: string;
  categoryLabels: Record<string, string>;
  activeLocales: string[];
};
const { config } = loadSite();
const routeSegment = `categories/${encodeURIComponent(Astro.params.category)}`;
const canonical = canonicalUrl(`/${routeSegment}/`, config.site.url);
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, routeSegment);
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
const mappedPosts = list.map((post) => ({
  slug: post.id,
  url: withBase(postPath(post, config.site.locale) + "/"),
  data: {
    title: post.data.title,
    tags: post.data.tags,
    category: post.data.category || null,
    published: post.data.pubDate,
  },
}));
const collectionJsonLd = collectionPageJsonLd({
  name: label,
  description: `分类 ${label} 下的全部文章`,
  url: canonical,
  inLanguage: config.site.locale,
  items: list.map((post) => canonicalUrl(postPath(post, config.site.locale) + "/", config.site.url)),
});
const breadcrumbJsonLd = breadcrumbListJsonLd([
  { name: "首页", url: canonicalUrl("/", config.site.url) },
  { name: "分类", url: canonicalUrl("/categories/", config.site.url) },
  { name: label, url: canonical },
]);
---
<MainGridLayout title={label} description={`分类 ${label} 下的全部文章`} page="categories" canonical={canonical} alternates={alternates}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <a href={withBase("/categories/")} class="text-[var(--primary)]">← 全部分类</a>
  <PageHeader icon="material-symbols:folder-outline-rounded" title={label} subtitle={`${list.length} 篇文章`} />
  <ArchivePanel
    client:visible
    sortedPosts={mappedPosts}
    initialCategory={Astro.params.category}
    preScoped
    breadcrumb={{ href: withBase("/categories/"), label: "分类", value: label }}
    categoryLabels={categoryLabels}
  />
</MainGridLayout>
