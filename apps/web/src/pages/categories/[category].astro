---
import { getCollection, type CollectionEntry } from "astro:content";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import PostPage from "@alnilam/theme-shirone/PostPage.astro";
import { withBase } from "../../lib/i18n.mjs";
import { loadSite } from "../../lib/site-source.mjs";
import { categoryDisplayLabel, comparePosts, loadSiteTaxonomy } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const { root, config } = loadSite();
  const taxonomy = loadSiteTaxonomy(root, config);
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const series = await getCollection("series");
  const seriesCategories = new Map(series.map((entry) => [entry.id, entry.data.defaultCategory]));
  const byCategory = new Map<string, CollectionEntry<"posts">[]>();
  for (const post of posts) {
    const category = post.data.category?.trim() || seriesCategories.get(post.data.series?.trim())?.trim();
    if (!category || category.includes("/")) continue;
    if (!byCategory.has(category)) byCategory.set(category, []);
    byCategory.get(category)!.push(post);
  }
  for (const entry of taxonomy.categories) {
    const matching = posts.filter(
      (post) =>
        post.data.category === entry.slug ||
        post.data.category === entry.id ||
        Object.values(entry.label).includes(post.data.category),
    );
    if (matching.length > 0 && !byCategory.has(entry.slug)) {
      byCategory.set(entry.slug, matching);
    }
  }
  return [...byCategory.entries()].map(([category, list]) => ({
    params: { category },
    props: {
      list: [...list].sort(comparePosts),
      label: categoryDisplayLabel(category, taxonomy.categories, config.site.locale),
    },
  }));
}

const { list, label } = Astro.props as { list: CollectionEntry<"posts">[]; label: string };
---
<MainGridLayout title={label} description={`分类 ${label} 下的全部文章`} page="categories">
  <a href={withBase("/categories/")} class="text-[var(--primary)]">← 全部分类</a>
  <PageHeader icon="material-symbols:folder-outline-rounded" title={label} subtitle={`${list.length} 篇文章`} />
  <PostPage page={{ data: list }} />
</MainGridLayout>
