---
import { getCollection, type CollectionEntry } from "astro:content";
import NativeArticle from "@alnilam/theme-shirone/Article.astro";
import Card from "@alnilam/theme-shirone/Card.svelte";
import Comments from "@alnilam/ui/Comments.svelte";
import { loadSite } from "../../lib/site-source.mjs";
import { canonicalUrl, postLang, translationAlternates } from "../../lib/i18n.mjs";
import { POSTS_PAGE_SIZE } from "../../lib/pagination.mjs";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts", ({ data }) => !data.draft);
  const { config } = loadSite();
  const lastPage = Math.ceil(allPosts.length / POSTS_PAGE_SIZE);
  for (const post of allPosts) {
    if (postLang(post, config.site.locale) !== config.site.locale) continue;
    const page = Number(post.id);
    if (String(page) === post.id && page >= 2 && page <= lastPage) {
      throw new Error(`Post slug "${post.id}" conflicts with pagination route /posts/${page}/.`);
    }
  }
  return allPosts.map((post) => {
    const lang = postLang(post, config.site.locale);
    return {
      // [...slug] rest param: id already contains "<lang>/" when the file lives
      // in a locale directory; otherwise prefix explicitly.
      params: { slug: lang === config.site.locale || post.id.startsWith(lang + "/") ? post.id : `${lang}/${post.id}` },
      props: { post, allPosts },
    };
  });
}
const { post, allPosts } = Astro.props as { post: CollectionEntry<"posts">; allPosts: CollectionEntry<"posts">[] };
const { config } = loadSite();
const alternates = translationAlternates(post, allPosts, config.site.locale);
---
<NativeArticle entry={post} discovery={{related: [], random: []}} series={null}>
  <Fragment slot="head">
    {alternates && [...alternates].map(([lang, path]) => <link rel="alternate" hreflang={lang} href={canonicalUrl(path + "/", config.site.url)} />)}
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    {post.data.tags.map(tag => <meta property="article:tag" content={tag} />)}
  </Fragment>
  {config.comments.enabled && (
    <section slot="comments" id="comments" class="mb-4" style="min-height:340px" aria-label="评论">
      <Card color="var(--card-bg)" radius="l" class="p-6">
      <Comments client:visible repo={config.comments.repo} repoId={config.comments.repoId}
        category={config.comments.category} categoryId={config.comments.categoryId}
        mapping={config.comments.mapping} theme={config.theme.appearance} lang={config.site.locale} />
      </Card>
    </section>
  )}
</NativeArticle>
