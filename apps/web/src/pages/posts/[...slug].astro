---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@alnilam/theme-shirone/BaseLayout.astro";
import Comments from "@alnilam/ui/Comments.svelte";
import { loadSite } from "../../lib/site-source.mjs";
import { canonicalUrl, postLang, postPath, translationAlternates, withBase } from "../../lib/i18n.mjs";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts", ({ data }) => !data.draft);
  const { config } = loadSite();
  return allPosts.map((post) => {
    const lang = postLang(post, config.site.locale);
    return {
      // [...slug] rest param: id already contains "<lang>/" when the file lives
      // in a locale directory; otherwise prefix explicitly.
      params: { slug: lang === config.site.locale || post.id.startsWith(lang + "/") ? post.id : `${lang}/${post.id}` },
      props: { post, allPosts },
    };
  });
}
const { post, allPosts } = Astro.props as { post: CollectionEntry<"posts">; allPosts: CollectionEntry<"posts">[] };
const { Content } = await render(post);
const { config } = loadSite();
const layout = { siteTitle: config.site.title, appearance: config.theme.appearance, locale: config.site.locale, showBangumi: config.bangumi?.enabled ?? false };
const dateIso = post.data.pubDate.toISOString();
const tags = post.data.tags;
const lang = postLang(post, config.site.locale);
const path = postPath(post, config.site.locale);
const alternates = (translationAlternates(post, allPosts, config.site.locale) ?? undefined) as Map<string, string> | undefined;
---
<BaseLayout
  title={post.data.title}
  {...layout}
  description={post.data.description}
  canonical={canonicalUrl(path + "/", config.site.url)}
  ogType="article"
  publishedTime={dateIso}
  tags={tags}
  alternates={alternates}
  htmlLang={lang}
>
  <article class="article-view">
    <header class="article-header">
      <div class="article-meta">
        <time datetime={dateIso}>{dateIso.slice(0, 10)}</time>
        {post.data.updatedDate && <span aria-label="更新于"> · 更新于 <time datetime={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toISOString().slice(0, 10)}</time></span>}
      </div>
      <h1>{post.data.title}</h1>
      {tags.length > 0 && (
        <div class="article-tags" aria-label="文章标签">
          {tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </div>
      )}
    </header>
    {post.data.cover && (
      <img
        src={withBase(post.data.cover)}
        alt=""
        loading="eager"
        decoding="async"
        width="640"
        height="360"
        class="article-cover"
      />
    )}
    <div class="prose-post"><Content /></div>
    {config.comments.enabled && (
      <section class="article-comments" aria-label="评论">
        <Comments
          client:visible
          repo={config.comments.repo}
          repoId={config.comments.repoId}
          category={config.comments.category}
          categoryId={config.comments.categoryId}
          mapping={config.comments.mapping}
          theme={config.theme.appearance}
          lang={config.site.locale}
        />
      </section>
    )}
    <nav class="article-return" aria-label="返回">
      <a href={withBase("/posts/")} class="pill-link">← 返回全部文章</a>
    </nav>
  </article>
</BaseLayout>
