---
import { getCollection } from "astro:content";
import NativeArticle from "@alnilam/theme-shirone/Article.astro";
import Card from "@alnilam/theme-shirone/Card.svelte";
import Comments from "virtual:alnilam-comments";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import { loadSite } from "../../lib/site-source.mjs";
import { canonicalUrl, postLang, postLocalSlug, postPath, translationAlternates, uiStrings, withBase } from "../../lib/i18n.mjs";
import { commentLang, commentsCsp, resolveCommentIdentity } from "../../lib/comments.mjs";
import { POSTS_PAGE_SIZE } from "../../lib/pagination.mjs";
import { articleSeriesContexts } from "../../lib/article-series";

import { llmsIndexPath, markdownPath, absolute } from "../../lib/llms.mjs";
export async function getStaticPaths() {
  const allPosts = await getCollection("posts", ({ data }) => !data.draft);
  const { config } = loadSite();
  const seriesContexts = await articleSeriesContexts(allPosts, config.site.locale);
  const lastPage = Math.ceil(allPosts.length / POSTS_PAGE_SIZE);
  const seenRoutes = new Set<string>();
  const seenTranslations = new Set<string>();
  for (const post of allPosts) {
    const lang = postLang(post, config.site.locale);
    if (lang === config.site.locale) {
      const slug = postLocalSlug(post, config.site.locale);
      const page = Number(slug);
      if (String(page) === slug && page >= 2 && page <= lastPage) {
        throw new Error(`Post slug "${slug}" conflicts with pagination route /posts/${page}/.`);
      }
    }
    if (post.data.translationKey) {
      const tk = `${lang}:${post.data.translationKey}`;
      if (seenTranslations.has(tk)) {
        throw new Error(`ALNILAM: duplicate translationKey "${post.data.translationKey}" for locale "${lang}"`);
      }
      seenTranslations.add(tk);
    }
  }
  return allPosts.flatMap((post) => {
    const lang = postLang(post, config.site.locale);
    const localSlug = postLocalSlug(post, config.site.locale);
    const oldSlug = lang === config.site.locale || post.id.startsWith(lang + "/") ? post.id : `${lang}/${post.id}`;
    const slugs = lang === config.site.locale && oldSlug !== localSlug ? [localSlug, oldSlug] : [oldSlug];
    return slugs.map((slug) => {
      if (seenRoutes.has(slug)) throw new Error(`ALNILAM: duplicate post route "/posts/${slug}/"`);
      seenRoutes.add(slug);
      return { params: { slug }, props: { post, allPosts, series: seriesContexts.get(post.id) ?? null, isLegacy: lang !== config.site.locale || slug !== localSlug } };
    });
  });
}
const { post, allPosts, series, isLegacy } = Astro.props;
const { config } = loadSite();
const lang = postLang(post, config.site.locale);
const t = uiStrings(lang);
const comment = !isLegacy && config.comments.enabled ? resolveCommentIdentity(post, config) : null;
const csp = !isLegacy ? commentsCsp(config) : null;
const targetPath = postPath(post, config.site.locale) + "/";
const canonical = canonicalUrl(targetPath, config.site.url);
const altMap = translationAlternates(post, allPosts, config.site.locale, config.locales);
const alternates = altMap
  ? [...altMap].map(([lang, path]) => ({ lang, href: canonicalUrl(path + "/", config.site.url) }))
  : undefined;
---
{isLegacy ? (
<MainGridLayout title={post.data.title} description={post.data.description || post.data.title} page="archive" lang={lang} canonical={canonical} noindex>
  <Card color="var(--card-bg)" radius="l" class="p-6">
    <PageHeader title={post.data.title} subtitle={post.data.description} />
    <p class="mt-4"><a href={withBase(targetPath)} class="text-[var(--primary)] font-semibold underline">{canonical}</a></p>
  </Card>
</MainGridLayout>
) : (
<NativeArticle entry={post} discovery={{related: [], random: []}} {series} canonical={canonical} alternates={alternates}>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    {config.llms.enabled && config.locales.includes(lang) && <link rel="alternate" type="text/markdown" href={absolute(markdownPath(post, config), config)} />}
    {config.llms.enabled && config.locales.includes(lang) && <link rel="describedby" type="text/plain" href={absolute(llmsIndexPath(lang, config), config)} />}
    {post.data.updatedDate && <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />}
    {post.data.category && <meta property="article:section" content={post.data.category} />}
    {post.data.tags.map(tag => <meta property="article:tag" content={tag} />)}
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
  </Fragment>
  {config.comments.enabled && comment && (
    <section slot="comments" id="comments" class="mb-4" style="min-height:340px" aria-label={t.commentsRegion}>
      <Card color="var(--card-bg)" radius="l" class="p-6">
      <Comments repo={config.comments.repo} repoId={config.comments.repoId}
        category={config.comments.category} categoryId={config.comments.categoryId}
        mapping={config.comments.mapping} term={comment.term} load={config.comments.load}
        theme={config.theme.appearance} lang={commentLang(config, lang)} labels={t} />
      </Card>
    </section>
  )}
</NativeArticle>
)}
