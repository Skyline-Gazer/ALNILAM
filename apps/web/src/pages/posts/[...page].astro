---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@alnilam/theme-shirone/BaseLayout.astro";
import PostCard from "@alnilam/theme-shirone/PostCard.astro";
import { loadSite } from "../../lib/site-source.mjs";
import { canonicalUrl, postPath, withBase } from "../../lib/i18n.mjs";

export async function getStaticPaths({ paginate }: { paginate: (items: CollectionEntry<"posts">[], opts: { pageSize: number; props: Record<string, unknown> }) => unknown[] }) {
  const { config } = loadSite();
  const posts = (await getCollection("posts", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, {
    pageSize: 5,
    props: { layout: { siteTitle: config.site.title, appearance: config.theme.appearance, locale: config.site.locale, showBangumi: config.bangumi?.enabled ?? false } },
  });
}
const { page, layout } = Astro.props as {
  page: { data: CollectionEntry<"posts">[]; currentPage: number; lastPage: number; url: { prev?: string; next?: string }; total: number; size: number };
  layout: { siteTitle: string; appearance: "dark" | "light"; locale: string };
};
const { config } = loadSite();
const canonicalPage = page.currentPage === 1 ? "/posts/" : `/posts/${page.currentPage}/`;
---
<BaseLayout
  title={page.currentPage === 1 ? "文章" : `文章 · 第 ${page.currentPage} 页`}
  {...layout}
  description="全部文章"
  canonical={canonicalUrl(canonicalPage, config.site.url)}
>
  <header class="page-heading">
    <p class="page-heading__eyebrow">Writing</p>
    <h1>全部文章</h1>
    <p>共 {page.total} 篇 · 第 {page.currentPage}/{page.lastPage} 页</p>
  </header>
  <div class="post-list">
    {page.data.length
      ? page.data.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            href={withBase(postPath(post, config.site.locale)) + "/"}
            published={post.data.pubDate}
            tags={post.data.tags}
            cover={post.data.cover}
          />
        ))
      : <p>暂无文章。</p>}
  </div>
  {(page.url.prev || page.url.next) && (
    <nav class="pagination" aria-label="分页">
      <span>
        {page.url.prev && <a href={page.url.prev} rel="prev" class="pill-link">← 上一页</a>}
      </span>
      <span>{page.currentPage} / {page.lastPage}</span>
      <span>
        {page.url.next && <a href={page.url.next} rel="next" class="pill-link">下一页 →</a>}
      </span>
    </nav>
  )}
</BaseLayout>
