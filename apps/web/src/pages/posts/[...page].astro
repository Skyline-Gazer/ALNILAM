---
import { getCollection } from "astro:content";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PostPage from "@alnilam/theme-shirone/PostPage.astro";
import Pagination from "@alnilam/theme-shirone/Pagination.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import { POSTS_PAGE_SIZE } from "../../lib/pagination.mjs";
import { comparePosts } from "../../lib/taxonomy";
import { canonicalUrl, filterPostsByLocale } from "../../lib/i18n.mjs";
import { loadSite } from "../../lib/site-source.mjs";
import LegacyFeed from "../../lib/LegacyFeed.astro";
import type { GetStaticPaths } from "astro";
export const getStaticPaths = (async ({paginate}) => {
  const { config } = loadSite();
  const allPosts = (await getCollection("posts", ({data}) => !data.draft)).sort(comparePosts);
  const posts = filterPostsByLocale(allPosts, config.site.locale, config.site.locale);
  return paginate(posts, {pageSize: POSTS_PAGE_SIZE});
}) satisfies GetStaticPaths;
const {page} = Astro.props;
const {config} = loadSite();
// Pagination pages are independently canonical: /posts/2/ points at itself.
const canonical = canonicalUrl(page.url.current, config.site.url);
const title = `文章 · 第 ${page.currentPage} 页`;
---
{page.currentPage === 1 ? <LegacyFeed locale={config.site.locale} /> :
<MainGridLayout {title} description="全部文章" page="archive" {canonical}>
  <PageHeader title="全部文章" subtitle={`共 ${page.total} 篇 · 第 ${page.currentPage}/${page.lastPage} 页`} />
  <PostPage page={page} />
  <Pagination {page} basePath="/posts/" firstPagePath="/" />
</MainGridLayout>}
