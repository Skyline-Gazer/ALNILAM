---
import { getCollection } from "astro:content";
import NativeArchive from "@alnilam/theme-shirone/Archive.astro";
import { activeContentLocales, canonicalUrl, routeAlternates } from "../../lib/i18n.mjs";
import { loadSite } from "../../lib/site-source.mjs";
const { config } = loadSite();
const posts = await getCollection("posts", ({ data }) => !data.draft);
const pages = await getCollection("pages", ({ data }) => !data.draft);
const activeLocales = activeContentLocales(posts, pages, config.site.locale, config.locales);
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, "archives");
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
---
<NativeArchive alternates={alternates} />
