---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@alnilam/theme-shirone/BaseLayout.astro";
import { loadSite } from "../../lib/site-source.mjs";
import { canonicalUrl, postPath, withBase } from "../../lib/i18n.mjs";
const { config } = loadSite();
const layout = { siteTitle: config.site.title, appearance: config.theme.appearance, locale: config.site.locale, showBangumi: config.bangumi?.enabled ?? false };
const posts: CollectionEntry<"posts">[] = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const byYear = new Map<string, CollectionEntry<"posts">[]>();
for (const post of posts) {
  const year = String(post.data.pubDate.getUTCFullYear());
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => Number(b) - Number(a));
---
<BaseLayout title="归档" {...layout} description="全部文章归档" canonical={canonicalUrl("/archives/", config.site.url)}>
  <header class="page-heading">
    <p class="page-heading__eyebrow">Archive</p>
    <h1>归档</h1>
    <p>共 {posts.length} 篇 · {years.length} 个年份</p>
  </header>
  {years.map((year) => (
    <section class="archive-year" aria-labelledby={`year-${year}`}>
      <h2 id={`year-${year}`}>{year}</h2>
      <ul class="archive-list">
        {byYear.get(year)!.map((post) => (
          <li>
            <a href={withBase(postPath(post, config.site.locale)) + "/"}>
              <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
              <span>{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  {posts.length === 0 && <p>暂无文章。</p>}
</BaseLayout>
