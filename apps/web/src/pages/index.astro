---
import { getCollection } from "astro:content";
import BaseLayout from "@alnilam/theme-editorial/BaseLayout.astro";
import PostCard from "@alnilam/theme-editorial/PostCard.astro";
import { loadSite } from "../lib/site-source.mjs";
const { config } = loadSite();
const layout = { siteTitle: config.site.title, appearance: config.theme.appearance, locale: config.site.locale };
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts.slice(0, 5);
const rest = posts.slice(5);
---
<BaseLayout title="首页" {...layout} description={config.site.description} canonical={new URL("/", config.site.url).toString()}>
  <!-- Cinematic hero: atmospheric, original constellation motif, no client JS -->
  <section class="hero-panel relative mb-14 flex min-h-80 flex-col justify-center overflow-hidden rounded-3xl px-7 py-14 sm:px-12" aria-labelledby="hero-title">
    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-60" viewBox="0 0 800 300" fill="none" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g stroke="var(--accent)" stroke-opacity=".25" stroke-width="1">
        <path d="M540 60 610 110 690 90 760 140" />
        <path d="M600 210 660 170 740 190" />
      </g>
      <g fill="var(--accent)">
        <circle cx="540" cy="60" r="2.5" fill-opacity=".8" />
        <circle cx="610" cy="110" r="3.5" fill-opacity=".65" />
        <circle cx="690" cy="90" r="2" fill-opacity=".5" />
        <circle cx="760" cy="140" r="2.8" fill-opacity=".7" />
        <circle cx="600" cy="210" r="2.2" fill-opacity=".5" />
        <circle cx="660" cy="170" r="3" fill-opacity=".6" />
        <circle cx="740" cy="190" r="2" fill-opacity=".4" />
      </g>
      <g fill="var(--fg-muted)">
        <circle cx="120" cy="40" r="1.4" fill-opacity=".5" />
        <circle cx="240" cy="80" r="1.1" fill-opacity=".4" />
        <circle cx="380" cy="30" r="1.6" fill-opacity=".45" />
        <circle cx="90" cy="180" r="1.2" fill-opacity=".35" />
        <circle cx="320" cy="240" r="1.3" fill-opacity=".4" />
      </g>
    </svg>
    <div class="relative">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[.3em]" style="color: var(--accent)">An extensible blogging platform</p>
      <h1 id="hero-title" class="text-5xl font-black tracking-tight sm:text-7xl" style="color: var(--fg)">{config.site.title}</h1>
      <p class="mt-5 max-w-lg leading-7" style="color: var(--fg-muted)">{config.site.description}</p>
    </div>
  </section>
  <section aria-labelledby="latest-posts">
    <h2 id="latest-posts" class="mb-6 text-2xl font-bold tracking-tight" style="color: var(--fg)">最近文章</h2>
    <div class="space-y-4">
      {latest.length
        ? latest.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              href={"/posts/" + post.id + "/"}
              published={post.data.pubDate}
              tags={post.data.tags}
              cover={post.data.cover}
            />
          ))
        : <p style="color: var(--fg-muted)">暂无文章。</p>}
    </div>
    {rest.length > 0 && (
      <div class="mt-8 text-center">
        <a
          href="/posts/"
          class="inline-block rounded-full px-6 py-2.5 text-sm font-medium transition-colors"
          style="border: 1px solid var(--border); color: var(--fg-soft); background: var(--bg-card)"
        >
          查看全部 {posts.length} 篇文章 →
        </a>
      </div>
    )}
  </section>
</BaseLayout>
