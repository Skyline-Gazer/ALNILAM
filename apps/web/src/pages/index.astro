---
// Actual pinned Shirone layout and post-list components, retained ALNILAM Site loader.
import MainGridLayout from '@alnilam/theme-shirone/MainGridLayout.astro';
import PostPage from '@alnilam/theme-shirone/PostPage.astro';
import Pagination from '@alnilam/theme-shirone/Pagination.astro';
import {getCollection} from 'astro:content';
import {comparePosts} from '../lib/taxonomy';
import { activeContentLocales, canonicalUrl, filterPostsByLocale, routeAlternates } from '../lib/i18n.mjs';
import {loadSite} from '../lib/site-source.mjs';
import {websiteJsonLd} from '../lib/seo.mjs';
import { POSTS_PAGE_SIZE } from '../lib/pagination.mjs';
const {config} = loadSite();
const allPosts = (await getCollection('posts', ({data}) => !data.draft)).sort(comparePosts);
const pages = await getCollection('pages', ({data}) => !data.draft);
const activeLocales = activeContentLocales(allPosts, pages, config.site.locale, config.locales);
// Locale content policy (#35): the default-locale home lists the default-locale corpus —
// the same rule as /<lang>/, /<lang>/posts/ and the per-locale RSS feed. Translations stay
// reachable through hreflang, the language switch and their own locale listings.
const posts = filterPostsByLocale(allPosts, config.site.locale, config.site.locale);
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, '');
const alternates = alts
  ? [...alts].map(([lang, path]) => ({lang, href: canonicalUrl(path, config.site.url)}))
  : undefined;
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PAGE_SIZE));
const page = {
  data: posts.slice(0, POSTS_PAGE_SIZE),
  currentPage: 1,
  lastPage,
  total: posts.length,
  size: POSTS_PAGE_SIZE,
  start: 0,
  end: Math.min(POSTS_PAGE_SIZE, posts.length) - 1,
  url: {
    current: '/',
    prev: undefined,
    next: lastPage > 1 ? '/posts/2/' : undefined,
    first: undefined,
    last: lastPage > 1 ? `/posts/${lastPage}/` : undefined,
  },
};
// The site root is the one page that describes the Site itself.
const jsonLd = websiteJsonLd({
  name: config.site.title,
  description: config.site.description,
  url: canonicalUrl('/', config.site.url),
  inLanguage: config.site.locale,
});
---
<MainGridLayout page="home" alternates={alternates}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <h1 class="sr-only">最近文章</h1>
  <PostPage page={page} />
  {lastPage > 1 && <Pagination page={page} basePath="/posts/" />}
</MainGridLayout>
