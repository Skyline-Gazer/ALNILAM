---
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PostPage from "@alnilam/theme-shirone/PostPage.astro";
import Pagination from "@alnilam/theme-shirone/Pagination.astro";
import { POSTS_PAGE_SIZE } from "../../lib/pagination.mjs";
import { getCollection } from "astro:content";
import { comparePosts } from "../../lib/taxonomy";
import {
  activeContentLocales,
  canonicalUrl,
  filterPostsByLocale,
  localeRoutePath,
  routeAlternates,
  uiStrings,
} from "../../lib/i18n.mjs";
import { loadSite } from "../../lib/site-source.mjs";
import { websiteJsonLd } from "../../lib/seo.mjs";

export async function getStaticPaths() {
  const { config } = loadSite();
  const allPosts = await getCollection("posts", ({ data }) => !data.draft);
  const allPages = await getCollection("pages", ({ data }) => !data.draft);
  const activeLocales = activeContentLocales(allPosts, allPages, config.site.locale, config.locales);
  return activeLocales
    .filter((locale) => locale !== config.site.locale)
    .map((locale) => ({
      params: { lang: locale },
      props: { locale, activeLocales, allPosts },
    }));
}

const { locale, activeLocales, allPosts } = Astro.props;
const { config } = loadSite();
const posts = filterPostsByLocale(allPosts, locale, config.site.locale).sort(comparePosts);
const feedUrl = posts.length > 0 ? undefined : null;
const currentPath = localeRoutePath(locale, config.site.locale, "");
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PAGE_SIZE));
const page = {
  data: posts.slice(0, POSTS_PAGE_SIZE),
  currentPage: 1,
  lastPage,
  total: posts.length,
  size: POSTS_PAGE_SIZE,
  start: 0,
  end: Math.min(POSTS_PAGE_SIZE, posts.length) - 1,
  url: {
    current: currentPath,
    prev: undefined,
    next: lastPage > 1 ? `${currentPath}posts/2/` : undefined,
    first: undefined,
    last: lastPage > 1 ? `${currentPath}posts/${lastPage}/` : undefined,
  },
};
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, "");
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
const jsonLd = websiteJsonLd({
  name: config.site.title,
  description: config.site.description,
  url: canonicalUrl(currentPath, config.site.url),
  inLanguage: locale,
});
const t = uiStrings(locale);
---
<MainGridLayout page="home" lang={locale} alternates={alternates} feedUrl={feedUrl}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <h1 class="sr-only">{t.recentPosts}</h1>
  <PostPage page={page} />
  {lastPage > 1 && <Pagination page={page} basePath={`${currentPath}posts/`} lang={locale} />}
</MainGridLayout>
