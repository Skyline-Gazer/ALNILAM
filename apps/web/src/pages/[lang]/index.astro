---
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PostPage from "@alnilam/theme-shirone/PostPage.astro";
import { getCollection } from "astro:content";
import { comparePosts } from "../../lib/taxonomy";
import {
  canonicalUrl,
  filterPostsByLocale,
  localeRoutePath,
  postLang,
  routeAlternates,
  uiStrings,
} from "../../lib/i18n.mjs";
import { loadSite } from "../../lib/site-source.mjs";
import { websiteJsonLd } from "../../lib/seo.mjs";

export async function getStaticPaths() {
  const { config } = loadSite();
  const allPosts = await getCollection("posts", ({ data }) => !data.draft);
  const activeLocales = config.locales.filter((locale) =>
    allPosts.some((post) => postLang(post, config.site.locale) === locale),
  );
  return activeLocales
    .filter((locale) => locale !== config.site.locale)
    .map((locale) => ({
      params: { lang: locale },
      props: { locale, activeLocales, allPosts },
    }));
}

const { locale, activeLocales, allPosts } = Astro.props;
const { config } = loadSite();
const posts = filterPostsByLocale(allPosts, locale, config.site.locale).sort(comparePosts);
const latest = posts.slice(0, 5);
const currentPath = localeRoutePath(locale, config.site.locale, "");
const page = {
  data: latest,
  currentPage: 1,
  lastPage: 1,
  total: latest.length,
  size: 5,
  start: 0,
  end: Math.max(0, latest.length - 1),
  url: { current: currentPath, prev: undefined, next: undefined, first: undefined, last: undefined },
};
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, "");
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
const jsonLd = websiteJsonLd({
  name: config.site.title,
  description: config.site.description,
  url: canonicalUrl(currentPath, config.site.url),
  inLanguage: locale,
});
const t = uiStrings(locale);
---
<MainGridLayout page="home" lang={locale} alternates={alternates}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <h1 class="sr-only">{t.recentPosts}</h1>
  <PostPage page={page} />
</MainGridLayout>
