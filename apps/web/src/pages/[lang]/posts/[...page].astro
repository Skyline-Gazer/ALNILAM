---
import { getCollection } from "astro:content";
import NativeArticle from "@alnilam/theme-shirone/Article.astro";
import Card from "@alnilam/theme-shirone/Card.svelte";
import Comments from "@alnilam/ui/Comments.svelte";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PostPage from "@alnilam/theme-shirone/PostPage.astro";
import Pagination from "@alnilam/theme-shirone/Pagination.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import { loadSite } from "../../../lib/site-source.mjs";
import { canonicalUrl, commentLabels, localeRoutePath, postLang, postLocalSlug, postPath, routeAlternates, translationAlternates, uiStrings } from "../../../lib/i18n.mjs";
import { commentLang, commentsCsp, resolveCommentIdentity } from "../../../lib/comments.mjs";
import { comparePosts } from "../../../lib/taxonomy";
import type { GetStaticPaths } from "astro";
import { POSTS_PAGE_SIZE } from "../../../lib/pagination.mjs";
import { llmsIndexPath, markdownPath, absolute } from "../../../lib/llms.mjs";

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(comparePosts);
  const { config } = loadSite();
  const activeLocales = config.locales.filter((locale) => allPosts.some((post) => postLang(post, config.site.locale) === locale));
  const routes = new Set<string>();
  const articleLocales = new Set(allPosts.map((post) => postLang(post, config.site.locale)));
  return [...articleLocales].filter((locale) => locale !== config.site.locale).flatMap((locale) => {
    const posts = allPosts.filter((post) => postLang(post, config.site.locale) === locale);
    const hasListing = activeLocales.includes(locale);
    const lastPage = hasListing ? Math.ceil(posts.length / POSTS_PAGE_SIZE) : 0;
    const listings = hasListing ? paginate(posts, { params: { lang: locale }, props: { locale, activeLocales }, pageSize: POSTS_PAGE_SIZE }) : [];
    const articles = posts.map((post) => {
      const slug = postLocalSlug(post, config.site.locale);
      const page = Number(slug);
      if (String(page) === slug && page >= 2 && page <= lastPage) {
        throw new Error(`Post slug "${slug}" conflicts with pagination route /${locale}/posts/${page}/.`);
      }
      const route = `${locale}/${slug}`;
      if (routes.has(route)) throw new Error(`ALNILAM: duplicate post route "/${locale}/posts/${slug}/"`);
      routes.add(route);
      return { params: { lang: locale, page: slug }, props: { post, allPosts, locale } };
    });
    return [...listings, ...articles];
  });
}) satisfies GetStaticPaths;
const { post, allPosts, locale, page, activeLocales } = Astro.props;
const { config } = loadSite();
const canonical = post ? canonicalUrl(postPath(post, config.site.locale) + "/", config.site.url) : canonicalUrl(page.url.current, config.site.url);
const altMap = post ? translationAlternates(post, allPosts, config.site.locale, config.locales) : page.currentPage === 1 ? routeAlternates(activeLocales, config.site.locale, config.locales, "posts") : null;
const alternates = altMap ? [...altMap].map(([lang, path]) => ({ lang, href: canonicalUrl(post ? path + "/" : path, config.site.url) })) : undefined;
const comment = post && config.comments.enabled ? resolveCommentIdentity(post, config) : null;
const csp = commentsCsp(config);
const t = uiStrings(locale);
const commentText = commentLabels(locale);
---
{post ? <NativeArticle entry={post} discovery={{related: [], random: []}} series={null} canonical={canonical} alternates={alternates}>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    {config.llms.enabled && config.locales.includes(locale) && <link rel="alternate" type="text/markdown" href={absolute(markdownPath(post, config), config)} />}
    {config.llms.enabled && config.locales.includes(locale) && <link rel="describedby" type="text/plain" href={absolute(llmsIndexPath(locale, config), config)} />}
    {post.data.updatedDate && <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />}
    {post.data.category && <meta property="article:section" content={post.data.category} />}
    {post.data.tags.map(tag => <meta property="article:tag" content={tag} />)}
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
  </Fragment>
  {config.comments.enabled && comment && (
    <section slot="comments" id="comments" class="mb-4" style="min-height:340px" aria-label={commentText.commentsRegion}>
      <Card color="var(--card-bg)" radius="l" class="p-6">
        <Comments client:visible repo={config.comments.repo} repoId={config.comments.repoId}
          category={config.comments.category} categoryId={config.comments.categoryId}
          mapping={config.comments.mapping} term={comment.term} load={config.comments.load}
          theme={config.theme.appearance} lang={commentLang(config, locale)} labels={commentText} />
      </Card>
    </section>
  )}
</NativeArticle> : <MainGridLayout title={page.currentPage === 1 ? t.postsTitle : t.pageTitle(page.currentPage)} description={t.allPosts} page="archive" lang={locale} canonical={canonical} alternates={alternates}>
  <PageHeader title={t.allPosts} subtitle={t.postsSubtitle(page.total, page.currentPage, page.lastPage)} />
  <PostPage page={page} />
  <Pagination page={page} basePath={localeRoutePath(locale, config.site.locale, "posts")} lang={locale} />
</MainGridLayout>}
