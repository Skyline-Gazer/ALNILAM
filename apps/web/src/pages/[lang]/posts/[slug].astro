---
import { getCollection, type CollectionEntry } from "astro:content";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import Card from "@alnilam/theme-shirone/Card.svelte";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import { loadSite } from "../../../lib/site-source.mjs";
import {
  canonicalUrl,
  postLang,
  postLocalSlug,
  postPath,
  withBase,
} from "../../../lib/i18n.mjs";
import { POSTS_PAGE_SIZE } from "../../../lib/pagination.mjs";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts", ({ data }) => !data.draft);
  const { config } = loadSite();
  return config.locales
    .filter((locale) => locale !== config.site.locale)
    .flatMap((locale) => {
      const localePosts = allPosts.filter((post) => postLang(post, config.site.locale) === locale);
      const lastPage = Math.ceil(localePosts.length / POSTS_PAGE_SIZE);
      return localePosts
        .map((post) => {
          const slug = postLocalSlug(post, config.site.locale);
          const pageNum = Number(slug);
          if (String(pageNum) === slug && pageNum >= 2 && pageNum <= lastPage) {
            return null;
          }
          return {
            params: { lang: locale, slug },
            props: { post, allPosts, locale },
          };
        })
        .filter((item): item is NonNullable<typeof item> => item !== null);
    });
}

const { post, locale } = Astro.props as {
  post: CollectionEntry<"posts">;
  allPosts: CollectionEntry<"posts">[];
  locale: string;
};
const { config } = loadSite();
const targetPath = postPath(post, config.site.locale) + "/";
const canonical = canonicalUrl(targetPath, config.site.url);
---
<MainGridLayout title={post.data.title} description={post.data.description || post.data.title} page="archive" lang={locale} canonical={canonical} noindex>
  <Card color="var(--card-bg)" radius="l" class="p-6">
    <PageHeader title={post.data.title} subtitle={post.data.description} />
    <p class="mt-4">
      <a href={withBase(targetPath)} class="text-[var(--primary)] font-semibold underline">{canonical}</a>
    </p>
  </Card>
</MainGridLayout>
