---
import { getCollection, type CollectionEntry } from "astro:content";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import ArchivePanel from "@alnilam/theme-shirone/ArchivePanel.svelte";
import {
  canonicalUrl,
  filterPostsByLocale,
  localeRoutePath,
  postPath,
  routeAlternates,
  uiStrings,
  withBase,
} from "../../../lib/i18n.mjs";
import { loadSite } from "../../../lib/site-source.mjs";
import { breadcrumbListJsonLd, collectionPageJsonLd } from "../../../lib/seo.mjs";
import { categoryDisplayLabel, comparePosts, loadSiteTaxonomy } from "../../../lib/taxonomy";

export async function getStaticPaths() {
  const { root, config } = loadSite();
  const taxonomy = loadSiteTaxonomy(root, config);
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const series = await getCollection("series");
  const seriesCategories = new Map(series.map((entry) => [entry.id, entry.data.defaultCategory]));

  const postCategory = (post: CollectionEntry<"posts">) =>
    post.data.category?.trim() || seriesCategories.get(post.data.series?.trim())?.trim() || "";

  const matchesCategory = (cat: string, target: string) => {
    if (cat === target) return true;
    const entry = taxonomy.categories.find((e) => e.slug === target || e.id === target);
    if (!entry) return false;
    return cat === entry.slug || cat === entry.id || Object.values(entry.label).includes(cat);
  };

  // All canonical category slugs present across posts
  const allCategorySlugs = new Set<string>();
  for (const post of posts) {
    const cat = postCategory(post);
    if (cat && !cat.includes("/")) allCategorySlugs.add(cat);
  }
  for (const entry of taxonomy.categories) {
    if (posts.some((p) => matchesCategory(postCategory(p), entry.slug))) {
      allCategorySlugs.add(entry.slug);
    }
  }

  return config.locales
    .filter((locale) => locale !== config.site.locale)
    .flatMap((locale) => {
      const localePosts = filterPostsByLocale(posts, locale, config.site.locale) as CollectionEntry<"posts">[];
      const categoryLabels = Object.fromEntries(
        taxonomy.categories.map((entry) => [
          entry.slug,
          categoryDisplayLabel(entry.slug, taxonomy.categories, locale),
        ]),
      );
      return [...allCategorySlugs]
        .map((category) => {
          const list = localePosts.filter((p) => matchesCategory(postCategory(p), category));
          if (list.length === 0) return null;
          // Active locales for this category: default locale (since /categories/<slug>/ has all posts)
          // plus any non-default locale that has >=1 post in this category.
          const activeLocales = config.locales.filter((loc) =>
            loc === config.site.locale
              ? posts.some((p) => matchesCategory(postCategory(p), category))
              : (filterPostsByLocale(posts, loc, config.site.locale) as CollectionEntry<"posts">[]).some((p) =>
                  matchesCategory(postCategory(p), category),
                ),
          );
          return {
            params: { lang: locale, category },
            props: {
              locale,
              category,
              list: [...list].sort(comparePosts),
              label: categoryDisplayLabel(category, taxonomy.categories, locale),
              categoryLabels,
              activeLocales,
            },
          };
        })
        .filter((item): item is NonNullable<typeof item> => item !== null);
    });
}

const { locale, category, list, label, categoryLabels, activeLocales } = Astro.props as {
  locale: string;
  category: string;
  list: CollectionEntry<"posts">[];
  label: string;
  categoryLabels: Record<string, string>;
  activeLocales: string[];
};
const { config } = loadSite();
const routeSegment = `categories/${encodeURIComponent(category)}`;
const canonical = canonicalUrl(localeRoutePath(locale, config.site.locale, routeSegment), config.site.url);
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, routeSegment);
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
const t = uiStrings(locale);
const categoriesIndexUrl = localeRoutePath(locale, config.site.locale, "categories");
const homeUrl = localeRoutePath(locale, config.site.locale, "");
const mappedPosts = list.map((post) => ({
  slug: post.id,
  url: withBase(postPath(post, config.site.locale) + "/"),
  data: {
    title: post.data.title,
    tags: post.data.tags,
    category: post.data.category || null,
    published: post.data.pubDate,
  },
}));
const collectionJsonLd = collectionPageJsonLd({
  name: label,
  description: t.categoryDesc(label),
  url: canonical,
  inLanguage: locale,
  items: list.map((post) => canonicalUrl(postPath(post, config.site.locale) + "/", config.site.url)),
});
const breadcrumbJsonLd = breadcrumbListJsonLd([
  { name: t.home, url: canonicalUrl(homeUrl, config.site.url) },
  { name: t.categories, url: canonicalUrl(categoriesIndexUrl, config.site.url) },
  { name: label, url: canonical },
]);
---
<MainGridLayout title={label} description={t.categoryDesc(label)} page="categories" lang={locale} canonical={canonical} alternates={alternates}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <a href={withBase(categoriesIndexUrl)} class="text-[var(--primary)]">{t.allCategories}</a>
  <PageHeader icon="material-symbols:folder-outline-rounded" title={label} subtitle={t.postsCount(list.length)} />
  <ArchivePanel
    client:visible
    sortedPosts={mappedPosts}
    initialCategory={category}
    preScoped
    breadcrumb={{ href: withBase(categoriesIndexUrl), label: t.categories, value: label }}
    categoryLabels={categoryLabels}
  />
</MainGridLayout>
