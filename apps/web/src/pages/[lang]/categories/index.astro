---
import { getCollection } from "astro:content";
import NativeCategories from "@alnilam/theme-shirone/Categories.astro";
import {
  activeContentLocales,
  canonicalUrl,
  filterPostsByLocale,
  routeAlternates,
} from "../../../lib/i18n.mjs";
import { categoryListing, loadSiteTaxonomy } from "../../../lib/taxonomy";
import { loadSite } from "../../../lib/site-source.mjs";

export async function getStaticPaths() {
  const { root, config } = loadSite();
  const taxonomy = loadSiteTaxonomy(root, config);
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const series = await getCollection("series");
  const seriesCategories = new Map(series.map((entry) => [entry.id, entry.data.defaultCategory]));
  const pages = await getCollection("pages", ({ data }) => !data.draft);

  const activeLocales = activeContentLocales(posts, pages, config.site.locale, config.locales);

  return activeLocales
    .filter((locale) => locale !== config.site.locale)
    .map((locale) => {
      const localePosts = filterPostsByLocale(posts, locale, config.site.locale);
      // Same helper as the default-locale route; only the locale argument differs (#35).
      const categories = categoryListing(posts, {
        locale,
        defaultLocale: config.site.locale,
        taxonomy,
        seriesCategories,
      });
      return {
        params: { lang: locale },
        props: { locale, categories, activeLocales, feedUrl: localePosts.length > 0 ? undefined : null },
      };
    });
}

const { locale, categories, activeLocales, feedUrl } = Astro.props;
const { config } = loadSite();
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, "categories");
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
---
<NativeCategories lang={locale} categories={categories} alternates={alternates} feedUrl={feedUrl} />
