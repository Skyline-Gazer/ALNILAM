---
import { getCollection, type CollectionEntry } from "astro:content";
import NativeArchive from "@alnilam/theme-shirone/Archive.astro";
import {
  activeContentLocales,
  canonicalUrl,
  filterPostsByLocale,
  routeAlternates,
} from "../../../lib/i18n.mjs";
import { archiveListing, comparePosts } from "../../../lib/taxonomy";
import { loadSite } from "../../../lib/site-source.mjs";

export async function getStaticPaths() {
  const { config } = loadSite();
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(comparePosts);
  const pages = await getCollection("pages", ({ data }) => !data.draft);
  const activeLocales = activeContentLocales(posts, pages, config.site.locale, config.locales);
  return activeLocales
    .filter((locale) => locale !== config.site.locale)
    .map((locale) => {
      // Same helper as the default-locale route; only the locale argument differs (#35).
      const sortedPosts = archiveListing(posts, { locale, defaultLocale: config.site.locale });
      const localePosts = filterPostsByLocale(posts, locale, config.site.locale);
      return {
        params: { lang: locale },
        props: { locale, sortedPosts, activeLocales, feedUrl: localePosts.length > 0 ? undefined : null },
      };
    });
}

const { locale, sortedPosts, activeLocales, feedUrl } = Astro.props;
const { config } = loadSite();
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, "archives");
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
---
<NativeArchive lang={locale} sortedPosts={sortedPosts} alternates={alternates} feedUrl={feedUrl} />
