---
import { getCollection } from "astro:content";
import NativeTags from "@alnilam/theme-shirone/Tags.astro";
import {
  canonicalUrl,
  filterPostsByLocale,
  localeRoutePath,
  postLang,
  routeAlternates,
  withBase,
} from "../../../lib/i18n.mjs";
import { loadSite } from "../../../lib/site-source.mjs";
import { canonicalTagSlug, loadSiteTaxonomy, tagDisplayLabel } from "../../../lib/taxonomy";

export async function getStaticPaths() {
  const { root, config } = loadSite();
  const taxonomy = loadSiteTaxonomy(root, config);
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  const activeLocales = config.locales.filter((locale) =>
    posts.some((post) => postLang(post, config.site.locale) === locale && post.data.tags.length > 0),
  );

  return activeLocales
    .filter((locale) => locale !== config.site.locale)
    .map((locale) => {
      const localePosts = filterPostsByLocale(posts, locale, config.site.locale);
      const countMap = new Map<string, number>();
      for (const post of localePosts) {
        const seenInPost = new Set<string>();
        for (const rawTag of post.data.tags) {
          const slug = canonicalTagSlug(rawTag, taxonomy.tags);
          if (seenInPost.has(slug)) continue;
          seenInPost.add(slug);
          countMap.set(slug, (countMap.get(slug) ?? 0) + 1);
        }
      }
      const tags = [...countMap.entries()]
        .sort(([a], [b]) => a.toLowerCase().localeCompare(b.toLowerCase()))
        .map(([slug, count]) => ({
          name: tagDisplayLabel(slug, taxonomy.tags, locale),
          count,
          url: withBase(localeRoutePath(locale, config.site.locale, `tags/${encodeURIComponent(slug)}`)),
        }));
      return {
        params: { lang: locale },
        props: { locale, tags, activeLocales },
      };
    });
}

const { locale, tags, activeLocales } = Astro.props;
const { config } = loadSite();
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, "tags");
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
---
<NativeTags lang={locale} tags={tags} alternates={alternates} />
