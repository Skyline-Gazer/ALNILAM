---
import { getCollection } from "astro:content";
import NativeTags from "@alnilam/theme-shirone/Tags.astro";
import {
  activeContentLocales,
  canonicalUrl,
  filterPostsByLocale,
  routeAlternates,
} from "../../../lib/i18n.mjs";
import { loadSiteTaxonomy, tagListing } from "../../../lib/taxonomy";
import { loadSite } from "../../../lib/site-source.mjs";

export async function getStaticPaths() {
  const { root, config } = loadSite();
  const taxonomy = loadSiteTaxonomy(root, config);
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const pages = await getCollection("pages", ({ data }) => !data.draft);

  const activeLocales = activeContentLocales(posts, pages, config.site.locale, config.locales);

  return activeLocales
    .filter((locale) => locale !== config.site.locale)
    .map((locale) => {
      const localePosts = filterPostsByLocale(posts, locale, config.site.locale);
      // Same helper as the default-locale route; only the locale argument differs (#35).
      const tags = tagListing(posts, { locale, defaultLocale: config.site.locale, taxonomy });
      return {
        params: { lang: locale },
        props: { locale, tags, activeLocales, feedUrl: localePosts.length > 0 ? undefined : null },
      };
    });
}

const { locale, tags, activeLocales, feedUrl } = Astro.props;
const { config } = loadSite();
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, "tags");
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
---
<NativeTags lang={locale} tags={tags} alternates={alternates} feedUrl={feedUrl} />
