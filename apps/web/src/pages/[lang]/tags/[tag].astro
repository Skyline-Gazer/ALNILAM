---
import { getCollection, type CollectionEntry } from "astro:content";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import ArchivePanel from "@alnilam/theme-shirone/ArchivePanel.svelte";
import {
  canonicalUrl,
  filterPostsByLocale,
  localeRoutePath,
  postPath,
  routeAlternates,
  uiStrings,
  withBase,
} from "../../../lib/i18n.mjs";
import { loadSite } from "../../../lib/site-source.mjs";
import { breadcrumbListJsonLd, collectionPageJsonLd } from "../../../lib/seo.mjs";
import { canonicalTagSlug, comparePosts, loadSiteTaxonomy, tagDisplayLabel } from "../../../lib/taxonomy";

export async function getStaticPaths() {
  const { root, config } = loadSite();
  const taxonomy = loadSiteTaxonomy(root, config);
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  const allCanonicalTags = new Set<string>();
  for (const post of posts) {
    for (const rawTag of post.data.tags) {
      allCanonicalTags.add(canonicalTagSlug(rawTag, taxonomy.tags));
    }
  }

  return config.locales
    .filter((locale) => locale !== config.site.locale)
    .flatMap((locale) => {
      const localePosts = filterPostsByLocale(posts, locale, config.site.locale) as CollectionEntry<"posts">[];
      const tagLabels = Object.fromEntries(
        taxonomy.tags.map((entry) => [entry.slug, tagDisplayLabel(entry.slug, taxonomy.tags, locale)]),
      );
      return [...allCanonicalTags]
        .map((tagSlug) => {
          const list = localePosts.filter((post) =>
            post.data.tags.some((t) => canonicalTagSlug(t, taxonomy.tags) === tagSlug),
          );
          if (list.length === 0) return null;
          const activeLocales = [
            config.site.locale,
            ...config.locales.filter(
              (loc) =>
                loc !== config.site.locale &&
                (filterPostsByLocale(posts, loc, config.site.locale) as CollectionEntry<"posts">[]).some((post) =>
                  post.data.tags.some((t: string) => canonicalTagSlug(t, taxonomy.tags) === tagSlug),
                ),
            ),
          ];
          return {
            params: { lang: locale, tag: tagSlug },
            props: {
              locale,
              tagSlug,
              list: [...list].sort(comparePosts),
              label: tagDisplayLabel(tagSlug, taxonomy.tags, locale),
              tagLabels,
              activeLocales,
            },
          };
        })
        .filter((item): item is NonNullable<typeof item> => item !== null);
    });
}

const { locale, tagSlug, list, label, tagLabels, activeLocales } = Astro.props as {
  locale: string;
  tagSlug: string;
  list: CollectionEntry<"posts">[];
  label: string;
  tagLabels: Record<string, string>;
  activeLocales: string[];
};
const { config } = loadSite();
const routeSegment = `tags/${encodeURIComponent(tagSlug)}`;
const canonical = canonicalUrl(localeRoutePath(locale, config.site.locale, routeSegment), config.site.url);
const alts = routeAlternates(activeLocales, config.site.locale, config.locales, routeSegment);
const alternates = alts
  ? [...alts].map(([lang, path]) => ({ lang, href: canonicalUrl(path, config.site.url) }))
  : undefined;
const t = uiStrings(locale);
const tagsIndexUrl = localeRoutePath(locale, config.site.locale, "tags");
const homeUrl = localeRoutePath(locale, config.site.locale, "");
const mappedPosts = list.map((post) => ({
  slug: post.id,
  url: withBase(postPath(post, config.site.locale) + "/"),
  data: {
    title: post.data.title,
    tags: post.data.tags,
    category: post.data.category || null,
    published: post.data.pubDate,
  },
}));
const collectionJsonLd = collectionPageJsonLd({
  name: `#${label}`,
  description: t.tagDesc(label),
  url: canonical,
  inLanguage: locale,
  items: list.map((post) => canonicalUrl(postPath(post, config.site.locale) + "/", config.site.url)),
});
const breadcrumbJsonLd = breadcrumbListJsonLd([
  { name: t.home, url: canonicalUrl(homeUrl, config.site.url) },
  { name: t.tags, url: canonicalUrl(tagsIndexUrl, config.site.url) },
  { name: `#${label}`, url: canonical },
]);
---
<MainGridLayout title={`#${label}`} description={t.tagDesc(label)} page="tags" lang={locale} canonical={canonical} alternates={alternates}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <a href={withBase(tagsIndexUrl)} class="text-[var(--primary)]">{t.allTags}</a>
  <PageHeader title={`#${label}`} subtitle={t.postsCount(list.length)} />
  <ArchivePanel
    client:visible
    sortedPosts={mappedPosts}
    initialTag={tagSlug}
    preScoped
    breadcrumb={{ href: withBase(tagsIndexUrl), label: t.tags, value: `#${label}` }}
    tagLabels={tagLabels}
  />
</MainGridLayout>
