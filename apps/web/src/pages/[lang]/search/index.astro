---
import { getCollection } from "astro:content";
import SearchRoute from "../../../components/SearchRoute.astro";
import { activeContentLocales } from "../../../lib/i18n.mjs";
import { loadSite } from "../../../lib/site-source.mjs";

export async function getStaticPaths() {
  const { config } = loadSite();
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const pages = await getCollection("pages", ({ data }) => !data.draft);
  const activeLocales = activeContentLocales(posts, pages, config.site.locale, config.locales);
  return activeLocales
    .filter((locale) => locale !== config.site.locale)
    .map((locale) => ({ params: { lang: locale }, props: { locale } }));
}
const { locale } = Astro.props;
---
<SearchRoute locale={locale} />
