---
import { getCollection } from "astro:content";
import SearchRoute from "../../../components/SearchRoute.astro";
import { postLang } from "../../../lib/i18n.mjs";
import { loadSite } from "../../../lib/site-source.mjs";

export async function getStaticPaths() {
  const { config } = loadSite();
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return config.locales
    .filter((locale) => locale !== config.site.locale && posts.some((post) => postLang(post, config.site.locale) === locale))
    .map((locale) => ({ params: { lang: locale }, props: { locale } }));
}
const { locale } = Astro.props;
---
<SearchRoute locale={locale} />
