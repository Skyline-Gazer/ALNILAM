---
import AlbumSection from "@alnilam/theme-shirone/AlbumSection.svelte";
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import type { AlbumIndexItem } from "@alnilam/theme-shirone/album-types";
import { galleryPageText, loadSiteGallery, toAlbumIndexItem } from "../lib/gallery.mjs";

interface Props {
  siteRoot: string;
  locale: string;
}

const { siteRoot, locale } = Astro.props;
const copy = galleryPageText(locale);
const albums: AlbumIndexItem[] = loadSiteGallery(siteRoot).map(toAlbumIndexItem);
---
<MainGridLayout lang={locale} title={copy.title} description={copy.description} page="albums">
  <AlbumSection {albums} title={copy.title} subtitle={copy.description} client:visible />
</MainGridLayout>
