---
import MainGridLayout from "@alnilam/theme-shirone/MainGridLayout.astro";
import PageHeader from "@alnilam/theme-shirone/PageHeader.astro";
import Card from "@alnilam/theme-shirone/Card.svelte";
import { loadSite } from "../lib/site-source.mjs";
import { fetchBangumiCollections } from "../lib/bangumi.mjs";
import { withBase } from "../lib/i18n.mjs";

// Injected via astro.config.mjs only when [bangumi] enabled = true — the page
// never ships for disabled modules.
const { config } = loadSite();
let collections: { name: string; nameCn: string; cover: string; href: string; summary: string; comment: string; updatedAt: string }[] = [];
let error: string | null = null;
try {
  collections = await fetchBangumiCollections(config.bangumi);
} catch (e: unknown) {
  error = String((e as Error).message ?? e);
}
---
<MainGridLayout title="番组计划" description={`${config.bangumi.userId} 的 ${config.bangumi.subjectType} 收藏`}>
  <Card color="var(--card-bg)" radius="l" class="p-6 mb-4">
    <PageHeader title="Bangumi 收藏" />
    <p>
      <a href={`https://bgm.tv/user/${config.bangumi.userId}`} rel="noopener noreferrer">@{config.bangumi.userId}</a>
      · {config.bangumi.subjectType} · 数据在构建时获取
    </p>
  </Card>
  {error && (
    <p class="module-alert" role="alert">
      Bangumi 数据获取失败（构建时）：{error}。页面其余部分不受影响。
    </p>
  )}
  {collections.length ? (
    <ul class="flex flex-col gap-4">
      {collections.map((c) => (
        <li><Card color="var(--card-bg)" radius="l" class="flex flex-row gap-4 p-4">
          {c.cover && (
            <img
              src={withBase(c.cover)}
              alt=""
              loading="lazy"
              decoding="async"
              width="200"
              height="280"
              referrerpolicy="no-referrer"
              class="w-24 h-auto shrink-0 object-cover rounded-xl"
              style="background: var(--surface-container)"
            />
          )}
          <div class="min-w-0">
            <h2>
              {c.href ? <a href={c.href} rel="noopener noreferrer" >{c.nameCn}</a> : c.nameCn}
            </h2>
            {c.nameCn !== c.name && <p class="text-[var(--on-surface-variant)]">{c.name}</p>}
            <p class="mt-2 line-clamp-4">{c.summary}</p>
          </div>
        </Card></li>
      ))}
    </ul>
  ) : (
    !error && <p>暂无收藏。</p>
  )}
</MainGridLayout>
