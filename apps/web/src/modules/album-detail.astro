---
import type { GetStaticPaths } from "astro";
import GalleryDetailPage from "../components/GalleryDetailPage.astro";
import { loadSiteGallery } from "../lib/gallery.mjs";
import { loadSite } from "../lib/site-source.mjs";

import type { AlbumGroup } from "@alnilam/theme-shirone/album-types";

interface Props {
  locale: string;
  album: AlbumGroup;
}

export const getStaticPaths: GetStaticPaths = () => {
  const { root, config } = loadSite();
  const albums = loadSiteGallery(root);
  return albums.map((album) => ({ params: { id: album.id }, props: { locale: config.site.locale, album } }));
};

const { album, locale } = Astro.props;
---
<GalleryDetailPage album={album} locale={locale} />
