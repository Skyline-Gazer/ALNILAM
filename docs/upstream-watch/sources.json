      "defaultBranch": "master",
      "role": "selective feature fallback",
      "baselineRevision": "14da4262d8aa1d93dc8cff11705f14918ed7369f",
      "license": "Apache-2.0",
      "policy": "Selective compatibility-safe reference; no automatic feature or visual port."
    },
    {
      "id": "kirari",
      "repository": "https://github.com/markd3ng/KIRARI",
      "defaultBranch": "main",
