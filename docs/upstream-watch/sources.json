      "baselineVersion": "1.0.6",
      "license": "MIT",
      "policy": "Selective fixes only; preserve ALNILAM adapters, single-router, PhotoSwipe, and Core/Site contracts."
    },
    {
      "id": "firefly",
      "repository": "https://github.com/CuteLeaf/Firefly",
      "defaultBranch": "master",
      "role": "selective feature and UX reference",
      "baselineRevision": "cd920b035b475fe9a6cd3a88afb42cf9440bb8a9",
      "license": "MIT",
      "policy": "Adapt only reproducible fixes with an ALNILAM defect or measured benefit; no theme/runtime replacement."
    },
    {
      "id": "mizuki",
