{
  "schema_version": 1,
  "policy": "required",
  "version_policy": "latest-stable",
  "production_branch": "main",
  "development_branches": ["dev", "feat/*", "fix/*", "chore/*"],
  "tools": {
    "codegraph": {
      "required": true,
      "upstream": "andysom25/codegraph",
      "version_policy": "latest-stable-preferred",
      "fallback": {
        "channel": "official-source",
        "enabled_only_with_explicit_approval": true,
        "approved_source_sha": "bb11bc1226db30233ac9e66a2670c4b16dfa85fa",
        "observed_release_absence_required": true,
        "never_claim_latest_stable": true
      },
      "initialize_command": "codegraph init",
      "sync_policy": "native-auto-sync-with-status-preflight-and-manual-recovery-only"
    },
    "rtk": {
      "required": true,
      "edition": "full",
      "upstream": "rtk-ai/rtk",
      "version_policy": "latest-stable",
      "verify_binary": "rtk --version",
      "verify_host_integration": true,
      "license_policy": "Apache-2.0+BUSL-1.1-full-only"
    }
  },
  "dev_only_paths": [
    ".ads-devtools.json",
    ".codex/hooks.json",
    "RTK.md"
  ]
}
