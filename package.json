{
  "name": "alnilam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @alnilam/web dev",
    "build": "node scripts/compose.mjs --site sites/demo --out dist/site && node scripts/artifact-check.mjs dist/site",
    "compose": "node scripts/compose.mjs",
    "artifact-check": "node scripts/artifact-check.mjs",
    "check": "pnpm --filter @alnilam/web check",
    "test": "node --test scripts/tests/*.test.mjs scripts/ci/*.test.mjs",
    "browser": "playwright test",
    "verify": "pnpm test && pnpm check && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@lhci/cli": "0.15.1"
  }
}
