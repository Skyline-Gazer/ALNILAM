.custom-md
  overflow-wrap: anywhere

  img
    border-radius: var(--shape-corner-m)

  hr
    border: 0
    border-top: 1px solid var(--line-divider)

  iframe
    border-radius: var(--shape-corner-m)
    margin-left: auto
    margin-right: auto
    max-width: 100%

  pre
    overflow-x: auto
    max-width: 100%

  table
    display: block
    max-width: 100%
    overflow-x: auto
