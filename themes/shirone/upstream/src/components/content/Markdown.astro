---
interface Props {
	class: string;
	noindex?: boolean;
}
const { class: className, noindex } = Astro.props;
---
<div data-pagefind-body={noindex ? undefined : ""} class={`prose dark:prose-invert prose-base !max-w-none custom-md markdown-content ${className}`}>
	<slot />
</div>

<style lang="stylus" is:global>
@import "../../styles/markdown/generic.styl"
</style>

<script>
	import { bindMarkdownRuntime } from "@utils/markdown-runtime";

	bindMarkdownRuntime();
</script>
