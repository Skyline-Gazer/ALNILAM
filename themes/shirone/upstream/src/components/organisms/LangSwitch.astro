---
import Icon from "@iconify/svelte";

// Keep the stylesheet global to avoid adding scoped Astro attributes to every link.
interface Props {
	label: string;
	homeLabel: string;
	targets: Array<{
		locale: string;
		label: string;
		href: string;
		active: boolean;
		exact: boolean;
	}>;
}

const { targets, label, homeLabel } = Astro.props;
---
{targets.length > 1 && (
	<>
		<button type="button" class="top-app-bar__lang-trigger m3-state-layer" popovertarget="header-languages" aria-label={label}>
			<Icon icon="material-symbols:translate-rounded" aria-hidden="true" />
		</button>
		<div id="header-languages" class="top-app-bar__lang" popover data-lang-switcher>
			{targets.map(({ locale, label, href, active, exact }) => (
				<a class="top-app-bar__lang-item" href={href} data-lang-target={locale} data-lang-exact={active ? undefined : String(exact)} aria-current={active ? "true" : undefined}>
					<span lang={locale}>{label}</span>
					{!active && !exact && <small>{homeLabel}</small>}
				</a>
			))}
		</div>
	</>
)}
