---
interface Props {
  title: string;
  description: string;
  href: string;
  published: Date;
  tags: string[];
  cover?: string;
}
const { title, description, href, published, tags, cover } = Astro.props;
---
<article class="group flex w-full flex-col-reverse gap-5 rounded-2xl border border-white/10 bg-white/[.045] p-5 transition hover:border-sky-300/30 hover:bg-white/[.075] md:min-h-48 md:flex-row md:items-center md:justify-between md:p-7">
  <div class="min-w-0 flex-1">
    <p class="mb-3 text-xs tracking-wide text-slate-400"><time datetime={published.toISOString()}>{published.toISOString().slice(0, 10)}</time></p>
    <h2 class="text-xl font-semibold leading-snug text-white md:text-2xl">
      <a href={href} class="hover:text-sky-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400">{title}</a>
    </h2>
    <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-slate-300">{description}</p>
    <div class="mt-4 flex flex-wrap gap-2" aria-label="文章标签">{tags.map((tag) => <span class="rounded-full bg-white/10 px-2.5 py-1 text-xs text-slate-300">#{tag}</span>)}</div>
  </div>
  {cover && <a href={href} aria-label={"阅读文章：" + title} class="block h-44 shrink-0 overflow-hidden rounded-xl md:h-40 md:w-[28%]"><img src={cover} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition group-hover:scale-105" /></a>}
</article>

